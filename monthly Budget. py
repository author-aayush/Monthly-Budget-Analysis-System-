import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import os

FILE = "budget_data.csv"

# --------------------------------------------------
# INPUT DATA FROM USER
# --------------------------------------------------

months = []
incomes = []
food = []
transport = []
education = []
shopping = []
other = []

n = int(input("Enter number of months: "))

for i in range(n):

    print("\nEnter details for Month", i + 1)

    month = input("Enter month name: ")

    income = float(input("Enter income: ₹"))

    f = float(input("Food expense: ₹"))
    t = float(input("Transport expense: ₹"))
    e = float(input("Education expense: ₹"))
    s = float(input("Shopping expense: ₹"))
    o = float(input("Other expense: ₹"))

    months.append(month)
    incomes.append(income)
    food.append(f)
    transport.append(t)
    education.append(e)
    shopping.append(s)
    other.append(o)


# --------------------------------------------------
# CREATE DATAFRAME
# --------------------------------------------------

df = pd.DataFrame({
    "Month": months,
    "Income": incomes,
    "Food": food,
    "Transport": transport,
    "Education": education,
    "Shopping": shopping,
    "Other": other
})


# --------------------------------------------------
# TOTAL EXPENSE
# --------------------------------------------------

expense_columns = [
    "Food",
    "Transport",
    "Education",
    "Shopping",
    "Other"
]

df["Total Expense"] = df[expense_columns].sum(axis=1)

df["Savings"] = df["Income"] - df["Total Expense"]

df["Savings %"] = (
    df["Savings"] / df["Income"] * 100
)


# --------------------------------------------------
# SAVE DATA TO CSV
# --------------------------------------------------

df.to_csv(FILE, index=False)


# --------------------------------------------------
# NUMPY CALCULATIONS
# --------------------------------------------------

expense_array = np.array(df["Total Expense"])

average_expense = np.mean(expense_array)
maximum_expense = np.max(expense_array)
minimum_expense = np.min(expense_array)


# --------------------------------------------------
# OVERALL SUMMARY
# --------------------------------------------------

total_income = df["Income"].sum()
total_expense = df["Total Expense"].sum()
total_savings = df["Savings"].sum()

savings_percentage = (
    total_savings / total_income * 100
)


print("\n======================================")
print("      MONTHLY BUDGET ANALYSIS")
print("======================================")

print("Total Income     : ₹", total_income)
print("Total Expense    : ₹", total_expense)
print("Total Savings    : ₹", total_savings)
print("Savings %        :", round(savings_percentage, 2), "%")

print("\nAverage Expense  : ₹", round(average_expense, 2))
print("Maximum Expense  : ₹", round(maximum_expense, 2))
print("Minimum Expense  : ₹", round(minimum_expense, 2))


# --------------------------------------------------
# DISPLAY DATA
# --------------------------------------------------

print("\nMONTHLY DATA")

print(df.to_string(index=False))


# --------------------------------------------------
# CATEGORY TOTALS
# --------------------------------------------------

category_totals = df[expense_columns].sum()

print("\nCATEGORY-WISE EXPENSE")

print(category_totals)


# ==================================================
# DASHBOARD
# ==================================================

fig = plt.figure(figsize=(15, 10))

fig.suptitle(
    "MONTHLY BUDGET ANALYSIS SYSTEM",
    fontsize=22,
    fontweight="bold"
)


# --------------------------------------------------
# SUMMARY CARDS
# --------------------------------------------------

cards = [
    ("TOTAL INCOME", total_income),
    ("TOTAL EXPENSE", total_expense),
    ("TOTAL SAVINGS", total_savings),
    ("SAVINGS %", savings_percentage)
]

for i, (title, value) in enumerate(cards):

    ax = fig.add_axes([
        0.05 + i * 0.235,
        0.82,
        0.20,
        0.10
    ])

    ax.set_xticks([])
    ax.set_yticks([])

    ax.text(
        0.5,
        0.65,
        title,
        ha="center",
        fontweight="bold"
    )

    if title == "SAVINGS %":
        text = f"{value:.2f}%"
    else:
        text = f"₹{value:,.0f}"

    ax.text(
        0.5,
        0.30,
        text,
        ha="center",
        fontsize=17,
        fontweight="bold"
    )


# --------------------------------------------------
# 1. MONTHLY EXPENSE BAR CHART
# --------------------------------------------------

ax1 = fig.add_axes([
    0.06,
    0.52,
    0.40,
    0.22
])

ax1.bar(
    df["Month"],
    df["Total Expense"]
)

ax1.set_title("Monthly Expenses")

ax1.set_ylabel("Expense (₹)")

ax1.tick_params(
    axis="x",
    rotation=45
)


# --------------------------------------------------
# 2. CATEGORY PIE CHART
# --------------------------------------------------

ax2 = fig.add_axes([
    0.55,
    0.50,
    0.35,
    0.25
])

ax2.pie(
    category_totals,
    labels=category_totals.index,
    autopct="%1.1f%%"
)

ax2.set_title("Expense by Category")


# --------------------------------------------------
# 3. INCOME VS EXPENSE
# --------------------------------------------------

ax3 = fig.add_axes([
    0.06,
    0.25,
    0.40,
    0.20
])

ax3.plot(
    df["Month"],
    df["Income"],
    marker="o",
    label="Income"
)

ax3.plot(
    df["Month"],
    df["Total Expense"],
    marker="o",
    label="Expense"
)

ax3.set_title("Income vs Expense")

ax3.set_ylabel("Amount (₹)")

ax3.tick_params(
    axis="x",
    rotation=45
)

ax3.legend()


# --------------------------------------------------
# 4. SAVINGS CHART
# --------------------------------------------------

ax4 = fig.add_axes([
    0.55,
    0.25,
    0.35,
    0.20
])

ax4.bar(
    df["Month"],
    df["Savings"]
)

ax4.set_title("Monthly Savings")

ax4.set_ylabel("Savings (₹)")

ax4.tick_params(
    axis="x",
    rotation=45
)


# --------------------------------------------------
# 5. SUMMARY TABLE
# --------------------------------------------------

ax5 = fig.add_axes([
    0.06,
    0.03,
    0.85,
    0.15
])

ax5.axis("off")

table_data = df[
    ["Month", "Income",
     "Total Expense",
     "Savings",
     "Savings %"]
].copy()

table_data["Income"] = table_data["Income"].map(
    lambda x: f"₹{x:,.0f}"
)

table_data["Total Expense"] = table_data[
    "Total Expense"
].map(
    lambda x: f"₹{x:,.0f}"
)

table_data["Savings"] = table_data[
    "Savings"
].map(
    lambda x: f"₹{x:,.0f}"
)

table_data["Savings %"] = table_data[
    "Savings %"
].map(
    lambda x: f"{x:.1f}%"
)

table = ax5.table(
    cellText=table_data.values,
    colLabels=table_data.columns,
    loc="center",
    cellLoc="center"
)

table.auto_set_font_size(False)

table.set_fontsize(9)

table.scale(1, 1.5)

ax5.set_title(
    "Monthly Summary",
    fontweight="bold"
)


# --------------------------------------------------
# DISPLAY DASHBOARD
# --------------------------------------------------

plt.show()